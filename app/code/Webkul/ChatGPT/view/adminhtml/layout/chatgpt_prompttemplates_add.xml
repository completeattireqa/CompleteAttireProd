<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Webkul_ChatGPT::css/promptTemplates.css"/>
    </head>
    <body>
        <referenceBlock name="menu">
            <action method="setActive">
                <argument name="itemId" xsi:type="string">Webkul_ChatGPT::chatgpt</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Webkul\ChatGPT\Block\Adminhtml\PromptTemplates" name="prompt_templates" template="Webkul_ChatGPT::prompt_templates.phtml"/>
        </referenceContainer>
    </body>
</page>
