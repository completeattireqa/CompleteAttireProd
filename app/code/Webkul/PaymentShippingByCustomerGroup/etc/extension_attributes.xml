<config>
    <extension_attributes for="Magento\Customer\Api\Data\GroupInterface">
        <attribute code="shipping_methods" type="string">
            <join reference_table="customer_group" reference_field="customer_group_id" join_on_field="customer_group_id">
                <field column="shipping_methods">shipping_methods</field>
            </join>
        </attribute>
        <attribute code="payment_methods" type="string">
            <join reference_table="customer_group" reference_field="customer_group_id" join_on_field="customer_group_id">
                <field column="payment_methods">payment_methods</field>
            </join>
        </attribute>
    </extension_attributes>
</config>