<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="adminhtml.customer.group.grid.columnSet">
            <block class="Magento\Backend\Block\Widget\Grid\Column" name="adminhtml.customer.group.grid.columnSet.shipping_methods" as="shipping_methods">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">Shipping Methods</argument>
                    <argument name="index" xsi:type="string">shipping_methods</argument>
                    <argument name="default" xsi:type="string">-</argument>
                    <argument name="renderer" xsi:type="string">Webkul\PaymentShippingByCustomerGroup\Block\Widget\Grid\Column\Renderer\ShippingLabel</argument>
                </arguments>
            </block>
            <block class="Magento\Backend\Block\Widget\Grid\Column" name="adminhtml.customer.group.grid.columnSet.payment_methods" as="payment_methods">
                <arguments>
                    <argument name="header" xsi:type="string" translate="true">Payment Methods</argument>
                    <argument name="index" xsi:type="string">payment_methods</argument>
                    <argument name="default" xsi:type="string">-</argument>
                    <argument name="renderer" xsi:type="string">Webkul\PaymentShippingByCustomerGroup\Block\Widget\Grid\Column\Renderer\PaymentLabel</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>