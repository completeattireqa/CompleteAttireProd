<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
       <css src="Webkul_Marketplace::css/product.css"/>
       <css src="Webkul_Marketplace::css/style.css"/>
       <css src="Webkul_MpGroupedProduct::css/grouped-product.css"/>
    </head>
    <body>
        <referenceContainer name="marketplace_product_add">
            <block class="Webkul\MpGroupedProduct\Block\Catalog\Option\DisplayProduct" name="grouped_product_grid" template="Webkul_MpGroupedProduct::product/grouped/grouped.phtml" cacheable="false">
                <block class="Magento\GroupedProduct\Block\Product\Grouped\AssociatedProducts\ListAssociatedProducts" name="grouped_product_test_name" as="list" template="Webkul_MpGroupedProduct::product/grouped/list.phtml"/>
            </block>
        </referenceContainer>
        <referenceContainer name="grouped_product_grid">
            <uiComponent name="mpgrouped_product_listing"/>
        </referenceContainer>
    </body>
</page>
