<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="marketplace">
            <group id="mpbraintree" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Braintree Transactional Emails</label>
                <field id="email_seller_bank_transfer_template" translate="label comment" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Marketplace Braintree Bank Transafer Template </label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
                <field id="email_cron_template" translate="label comment" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Marketplace Braintree Cron Excecute</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>
        </section>
        <section id="payment">
                <group id="mpbraintree" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label><![CDATA[Marketplace BrainTree Payment Gateway]]></label>

                        <field id="active" translate="label" type="select" sortOrder="101" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Enabled</label>
                            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        </field>

                        <field id="title" translate="label" type="text" sortOrder="102" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Title</label>
                            <validate>required-entry</validate>
                        </field>

                        <field id="environment" translate="label" type="select" sortOrder="103" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Environment</label>
                            <source_model>Webkul\MpBraintree\Model\Source\Environment</source_model>
                        </field>

                        <field id="account_id" translate="label" type="text" sortOrder="104" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Account Id</label>
                        </field>

                        <field id="merchant_id" translate="label" type="text" sortOrder="105" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Merchant Id</label>
                        </field>

                        <field id="public_key" translate="label" type="obscure" sortOrder="106" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Public Key</label>
                            <config_path>payment/mpbraintree/public_key</config_path>
                            <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        </field>

                        <field id="private_key" translate="label" type="obscure" sortOrder="107" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Private Key</label>
                            <config_path>payment/mpbraintree/private_key</config_path>
                            <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        </field>

                        <field id="tokenization_key" translate="label" type="text" sortOrder="108" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label>Tokenization Key</label>
                        </field>

                        <!--<field id="use_cvv" translate="label" type="select" sortOrder="109" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Use cvv at checkout</label>
                            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        </field>-->

                        <field id="allowspecific" translate="label" type="allowspecific" sortOrder="112" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Payment from Applicable Countries</label>
                            <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                        </field>

                        <field id="specificcountry" translate="label" type="multiselect" sortOrder="113" showInDefault="1" showInWebsite="1" showInStore="0">
                            <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                            <depends><field id="allowspecific">1</field></depends>
                        </field>

                        <field id="min_order_total" translate="label" type="text" sortOrder="115" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Minimum Order Total</label>
                            <comment>$0.50 is the minimum amount allowed by Braintree</comment>
                        </field>

                        <field id="max_order_total" translate="label" type="text" sortOrder="116" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Maximum Order Total</label>
                        </field>

                        <field id="sort_order" translate="label" type="text" sortOrder="117" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Sort Order</label>
                        </field>

                        <field id="tnc" translate="label" type="text" sortOrder="118" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Terms Of Services Link</label>
                        </field>

                        <field id="cc_vault_active" translate="label" type="select" sortOrder="119" showInDefault="1" showInWebsite="1" showInStore="0">
                            <label>Vault Enabled</label>
                            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        </field>

                        <group id="escrow_settings" translate="label" type="text" sortOrder="150" showInDefault="1" showInWebsite="1" showInStore="1">
                            <label><![CDATA[Escrow Settings]]></label>

                            <field id="hold" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                                <label>Hold In Escrow</label>
                                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                                <config_path>payment/mpbraintree/hold</config_path>
                            </field>

                            <field id="auto_release" translate="label" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="0">
                                <label>Auto Release</label>
                                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                                <config_path>payment/mpbraintree/auto_release</config_path>
                            </field>

                            <field id="escrow_hold_days" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="0">
                                <label>Release amount from escrow after days</label>
                                <validate>validate-number</validate>
                                <config_path>payment/mpbraintree/escrow_hold_days</config_path>
                            </field>
                        </group>
                </group>
        </section>
    </system>
</config>
